---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="About · 周晓昊" description="周晓昊的个人简介与教育经历。" active="about">
  <div class="section">
    <p class="page-kicker">ABOUT</p>
    <h1 class="hero-title">一个持续整理研究问题的学生。</h1>
    <div class="section-body">
      <p class="section-lede">我是重庆大学人工智能专业本科生，学习时间为 2023—2027。</p>
      <p class="section-lede">我的研究大方向是 Agent 和基础模型。这个网站暂时只记录已确认的个人信息和后续可公开维护的内容。</p>
    </div>
  </div>
  <div class="section">
    <h2 class="section-title">Education</h2>
    <div class="card"><div class="experience-item"><div class="institution-logo institution-mark" aria-hidden="true">CQU</div><div class="experience-content"><p class="exp-title"><strong>重庆大学</strong></p><p class="exp-detail">人工智能专业本科</p><p class="exp-period">2023 — 2027</p></div></div></div>
  </div>
  <div class="section">
    <h2 class="section-title">Research interests</h2>
    <div class="two-column"><div class="soft-card"><h3>Agent</h3><p>Terminal Agent、Code Agent、agent systems、trajectory 与 harness。</p></div><div class="soft-card"><h3>Models & evaluation</h3><p>基础模型、RL/RLVR、数据构造、benchmark、evaluator 和 ALE。</p></div></div>
  </div>
</BaseLayout>
