---
import "../styles/global.css";
import "../styles/markdown.css";
import Icon from "../components/Icon.astro";

const { title = "Xiaohao Zhou · Research Log", description = "Xiaohao Zhou 的研究博客与公开研究记录。", active = "home" } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const navItems = [
  ["home", "Home", base],
  ["about", "About", `${base}about/`],
  ["research", "Research", `${base}research/`],
  ["projects", "Projects", `${base}projects/`],
  ["blog", "Blog", `${base}blog/`],
  ["notes", "Notes", `${base}notes/`]
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}assets/img/favicon.svg`} type="image/svg+xml" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/academicons/1.9.4/css/academicons.min.css" crossorigin="anonymous" />
    <script src="https://kit.fontawesome.com/a860a211d3.js" crossorigin="anonymous"></script>
  </head>
  <body class="theme-luka">
    <nav class="top-nav" aria-label="主导航">
      <div class="nav-container">
        <a class="nav-home" href={base}>XH / research log</a>
        <div class="nav-right">
          <span class="nav-context">2023—2027 · CQU</span>
          <button id="themeToggle" class="theme-toggle" type="button" title="切换深色模式" aria-label="切换深色模式" aria-pressed="false"><Icon name="moon" /></button>
        </div>
      </div>
    </nav>

    <div class="wrapper">
      <aside class="sidebar">
        <div class="profile-card">
          <a class="image avatar" href={base} aria-label="返回首页"><img src={`${base}assets/img/avatar.jpg`} alt="周晓昊的人像照片" /></a>
          <h1 class="site-name">周晓昊</h1>
          <p class="site-role">Artificial Intelligence · Chongqing University</p>
          <div class="social-icons" aria-label="外部链接">
            <a href="https://github.com/Xiaohao-trumpet" target="_blank" rel="noreferrer" title="GitHub" aria-label="GitHub"><Icon name="github" /></a>
            <a href={`${base}blog/`} title="Blog" aria-label="Blog"><Icon name="book" /></a>
          </div>
          <nav class="profile-nav" aria-label="站内页面">
            {navItems.map(([key, label, href]) => <a class={active === key ? "list-active" : undefined} href={href} aria-current={active === key ? "page" : undefined}>{label}</a>)}
          </nav>
          <div class="visitor-card">
            <div class="visitor-card-title">Research log</div>
            <div class="visitor-card-body">公开 blog 记录整理后的思考；private notes 保留过程、草稿和问题。</div>
          </div>
        </div>
      </aside>

      <main class="content" id="main-content" tabindex="-1">
        <slot />
      </main>

      <footer class="site-footer">
        <p>© 2026 周晓昊 · <a href="https://github.com/wzsyyh/luka-homepage-template" target="_blank" rel="noreferrer">Luka Homepage Template</a> by <a href="https://wzsyyh.github.io/" target="_blank" rel="noreferrer">Yuheng Yang</a></p>
      </footer>
    </div>
    <script is:inline>
      const button = document.getElementById('themeToggle');
      const icon = button?.querySelector('.icon');
      const saved = localStorage.getItem('theme');
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      function setTheme(theme) {
        const dark = theme === 'dark';
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        if (icon) icon.innerHTML = dark ? '<path fill="currentColor" d="M12 4.1a7.9 7.9 0 1 0 0 15.8 7.9 7.9 0 0 0 0-15.8Zm0 13.8a5.9 5.9 0 1 1 0-11.8 5.9 5.9 0 0 1 0 11.8ZM11 0h2v3h-2V0Zm0 21h2v3h-2v-3ZM0 11h3v2H0v-2Zm21 0h3v2h-3v-2ZM3.5 2.1l2.1 2.1-1.4 1.4-2.1-2.1 1.4-1.4Zm15.8 15.8 2.1 2.1-1.4 1.4-2.1-2.1 1.4-1.4ZM2.1 20.5l2.1-2.1 1.4 1.4-2.1 2.1-1.4-1.4Zm15.8-15.8L20 2.6l1.4 1.4-2.1 2.1-1.4-1.4Z"/>' : '<path fill="currentColor" d="M20.8 15.7A8.8 8.8 0 0 1 8.3 3.2 9.5 9.5 0 1 0 20.8 15.7Z"/>';
        if (button) { button.setAttribute('aria-pressed', String(dark)); button.setAttribute('aria-label', dark ? '切换浅色模式' : '切换深色模式'); }
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      }
      setTheme(saved || (systemDark ? 'dark' : 'light'));
      button?.addEventListener('click', () => setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'));
    </script>
  </body>
</html>
